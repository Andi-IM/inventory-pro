        <bpmndi:BPMNLabel>
          <dc:Bounds x="853" y="196" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Task_FinalApproval" bpmnElement="Task_FinalApproval">
        <dc:Bounds x="675" y="138" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ParallelGateway_join" bpmnElement="ParallelGateway_join" isMarkerVisible="true">
        <dc:Bounds x="575" y="157" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="572" y="207" width="57" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_Flow_start_to_split" bpmnElement="Flow_start_to_split">
        <di:waypoint x="186" y="178" />
        <di:waypoint x="230" y="180" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_split_to_business" bpmnElement="Flow_split_to_business">
        <di:waypoint x="280" y="170" />
        <di:waypoint x="340" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_split_to_technical" bpmnElement="Flow_split_to_technical">
        <di:waypoint x="280" y="190" />
        <di:waypoint x="340" y="270" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_business_to_join" bpmnElement="Flow_business_to_join">
        <di:waypoint x="480" y="66" />
        <di:waypoint x="600" y="66" />
        <di:waypoint x="600" y="157" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_technical_to_join" bpmnElement="Flow_technical_to_join">
        <di:waypoint x="480" y="270" />
        <di:waypoint x="608" y="270" />
        <di:waypoint x="608" y="199" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_join_to_finalize" bpmnElement="Flow_join_to_finalize">
        <di:waypoint x="625" y="182" />
        <di:waypoint x="650" y="182" />
        <di:waypoint x="650" y="178" />
        <di:waypoint x="675" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_finalize_to_end" bpmnElement="Flow_finalize_to_end">
        <di:waypoint x="825" y="182" />
