<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_parallel_review" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.47.0" modeler:executionPlatform="Camunda Platform" modeler:executionPlatformVersion="7.24.0">
  <bpmn:process id="Process_1j9gubt" name="Parallel Review Process" isExecutable="true">
    <bpmn:startEvent id="StartEvent_1" name="Review Requested">
      <bpmn:outgoing>Flow_start_to_split</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:parallelGateway id="ParallelGateway_split" name="Start Parallel Reviews">
      <bpmn:incoming>Flow_start_to_split</bpmn:incoming>
      <bpmn:outgoing>Flow_split_to_business</bpmn:outgoing>
      <bpmn:outgoing>Flow_split_to_technical</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_BusinessReview" name="Business Review">
      <bpmn:incoming>Flow_split_to_business</bpmn:incoming>
      <bpmn:outgoing>Flow_business_to_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Task_TechnicalReview" name="Technical Review">
      <bpmn:incoming>Flow_split_to_technical</bpmn:incoming>
      <bpmn:outgoing>Flow_technical_to_join</bpmn:outgoing>
    </bpmn:task>
    <bpmn:parallelGateway id="ParallelGateway_join" name="All Reviews Completed">
      <bpmn:incoming>Flow_business_to_join</bpmn:incoming>
      <bpmn:incoming>Flow_technical_to_join</bpmn:incoming>
      <bpmn:outgoing>Flow_join_to_finalize</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:task id="Task_FinalApproval" name="Finalize Decision">
      <bpmn:incoming>Flow_join_to_finalize</bpmn:incoming>
      <bpmn:outgoing>Flow_finalize_to_end</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_1" name="Review Completed">
      <bpmn:incoming>Flow_finalize_to_end</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_start_to_split" sourceRef="StartEvent_1" targetRef="ParallelGateway_split" />
    <bpmn:sequenceFlow id="Flow_split_to_business" sourceRef="ParallelGateway_split" targetRef="Task_BusinessReview" />
    <bpmn:sequenceFlow id="Flow_split_to_technical" sourceRef="ParallelGateway_split" targetRef="Task_TechnicalReview" />
    <bpmn:sequenceFlow id="Flow_business_to_join" sourceRef="Task_BusinessReview" targetRef="ParallelGateway_join" />
    <bpmn:sequenceFlow id="Flow_technical_to_join" sourceRef="Task_TechnicalReview" targetRef="ParallelGateway_join" />
    <bpmn:sequenceFlow id="Flow_join_to_finalize" sourceRef="ParallelGateway_join" targetRef="Task_FinalApproval" />
    <bpmn:sequenceFlow id="Flow_finalize_to_end" sourceRef="Task_FinalApproval" targetRef="EndEvent_1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_parallel_review">
    <bpmndi:BPMNPlane id="BPMNPlane_parallel_review" bpmnElement="Process_1j9gubt">
